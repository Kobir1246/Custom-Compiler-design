%option noyywrap
%{
#include "parser.tab.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

extern YYSTYPE yylval;
%}

/* Rules start after this line */
%%

[ \t\r\n]+                 { /* skip whitespace */ }

/* C++ style single-line comments */
"//"[^\n]*                 { /* skip comment */ }

/* keywords (placed before ID rule) */
"int"                      { return KW_INT; }
"float"                    { return KW_FLOAT; }
"print"                    { return KW_PRINT; }
"if"                       { return KW_IF; }
"else"                     { return KW_ELSE; }

/* multi-character operators (use quotes for clarity) */
"=="                       { return EQ; }
"!="                       { return NEQ; }
"<="                       { return LE; }
">="                       { return GE; }

/* punctuation & single-char operators — quote special ones to avoid start-condition parsing */
";"                        { return SEMI; }
","                        { return COMMA; }
"("                        { return LP; }
")"                        { return RP; }
"{"                        { return LB; }
"}"                        { return RB; }
"+"                        { return PLUS; }
"-"                        { return MINUS; }
"*"                        { return MUL; }
"/"                        { return DIV; }

/* < and > must be quoted so flex doesn't treat them as start-condition markers */
"<"                        { return LT; }
">"                        { return GT; }

/* assignment */
"="                        { return ASSIGN; }

/* float literal: digits.digits */
[0-9]+\.[0-9]+             {
                             yylval.fval = atof(yytext);
                             return FLOAT_LITERAL;
                           }

/* integer literal */
[0-9]+                     {
                             yylval.ival = atoi(yytext);
                             return INT_LITERAL;
                           }

/* identifier: letter or underscore followed by letters/digits/underscores */
[a-zA-Z_][a-zA-Z0-9_]*     {
                             yylval.id = strdup(yytext);
                             return ID;
                           }

/* anything else: ignore or return char */
.                          { /* skip unknown char */ }

%%
